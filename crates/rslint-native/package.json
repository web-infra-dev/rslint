{
  "name": "@rslint/native",
  "version": "0.0.0",
  "private": true,
  "description": "Build-only Rust lint engine and Node addon. Platform packages publish the compiled .node.",
  "napi": {
    "binaryName": "rslint",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-unknown-linux-musl",
      "aarch64-pc-windows-msvc",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "node ../../scripts/tsrs/build-rust.mjs",
    "build:debug": "node ../../scripts/tsrs/build-rust.mjs --debug"
  },
  "devDependencies": {
    "@napi-rs/cli": "catalog:"
  }
}
