+    /// Exact compiler strings use byte arrays: JSON strings replace lone-surrogate WTF-8.
+    pub(crate) fn byte_string(&self, name: &str) -> CheckerResult<std::borrow::Cow<'a, str>> {
+        let key = format!("{name}Bytes");
+        let Some(raw) = self.raw(&key) else { return self.string(name).map(std::borrow::Cow::Borrowed); };
+        let Value::Array(values) = raw else { return Err(wrong_type(&key, "a byte array")); };
+        let bytes = values.iter().map(|v| unsigned(v, &key, 255.0).map(|n| n as u8)).collect::<CheckerResult<Vec<_>>>()?;
+        // The compiler represents JavaScript strings as UTF-8 plus encoded surrogate code units.
+        // Reject every other invalid sequence before constructing that established representation.
+        let mut rest = bytes.as_slice();
+        while let Err(error) = std::str::from_utf8(rest) {
+            rest = &rest[error.valid_up_to()..];
+            if rest.len() < 3 || rest[0] != 0xed || !(0xa0..=0xbf).contains(&rest[1]) || !(0x80..=0xbf).contains(&rest[2]) {
+                return Err(wrong_type(&key, "UTF-8 or WTF-8 bytes"));
+            }
+            rest = &rest[3..];
+        }
+        Ok(std::borrow::Cow::Owned(unsafe { String::from_utf8_unchecked(bytes) }))
+    }
+
     pub(crate) fn raw(&self, name: &str) -> Option<&'a Value> {
         get(self.obj, name)
     }
