+pub(crate) fn handle_rslint(
+    session: &Session,
+    method: &str,
+    params: &Value,
+) -> ApiResult<Response> {
+    let host = SessionHost { session };
+    let value = rslint::handle(&host, method, params).map_err(to_api_error)?;
+    json_response(&value)
+}
+
+impl Session {
+    /// Serialize/register a binder-owned symbol without initializing a type checker.
+    /// The caller must keep the symbol's allocation owner alive for the snapshot lifetime.
+    pub fn rslint_symbol_response(
+        &self,
+        snapshot: u64,
+        project: &str,
+        symbol: tsrs_core::P<tsrs_ast::Symbol>,
+    ) -> ApiResult<tsrs_core::json::Value> {
+        let host = SessionHost { session: self };
+        let context = setup::SnapshotCtx::new(&host, snapshot, project).map_err(to_api_error)?;
+        context.program().map_err(to_api_error)?;
+        context.symbol_response(symbol, project).map_err(to_api_error)
+    }
+
+    /// Resolve against the API's cached node table. The caller must retain SnapshotData
+    /// while the returned pointer is used; this does not transfer allocation ownership.
+    pub fn rslint_resolve_node(
+        &self,
+        snapshot: u64,
+        project: &str,
+        handle: &str,
+    ) -> ApiResult<tsrs_core::P<tsrs_ast::Node>> {
+        let data = self.snapshot_data(snapshot)?;
+        let program = data.get_program(&tsrs_project::ID(project.to_string()))?;
+        self.resolve_node_handle(program, handle)
+    }
+}
