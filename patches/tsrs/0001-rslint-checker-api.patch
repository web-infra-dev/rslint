+
+// Cooperative cleanup uses the same lease safety as the native timer, without
+// sleeping or letting the timer choose the test's scheduling order.
+#[test]
+fn checker_pool_cooperative_cleanup_retains_live_results() {
+    let (session, _) =
+        setup_checker_pool_session(CheckerPoolOptions { max_checkers: 3, idle_timeout: secs(30) });
+    let pool = new_test_checker_pool(
+        program_of(&session),
+        CheckerPoolOptions { max_checkers: 3, idle_timeout: secs(30) },
+    );
+    let diagnostics = pool.get_checker(&ctx_with("held-diag", CheckerLifetime::Diagnostics), None);
+    let diagnostic_ptr = ptr(&diagnostics);
+    let api = pool.get_checker(&ctx_with("api", CheckerLifetime::API), None);
+    let api_ptr = ptr(&api);
+    drop(api);
+    let lease = with_checker_data_lease(&ctx_with("leased-query", CheckerLifetime::Temporary));
+    drop(pool.get_checker(&lease, None));
+    {
+        let mut state = pool.mu.lock().unwrap();
+        if let Some(timer) = state.cleanup_timer.take() {
+            timer.stop();
+        }
+        // Expire the idle query deterministically. The held diagnostics checker
+        // remains exempt even if its last-release timestamp is old.
+        let expired = Instant::now() - secs(60);
+        for released in &mut state.last_released {
+            *released = Some(expired);
+        }
+    }
+    pool.cleanup_idle_checkers();
+    pool.test_state(|state| {
+        assert!(state.checkers[0], "held diagnostic checker must survive cleanup");
+        assert!(!state.checkers[1], "expired query slot must be reclaimed");
+        assert!(state.persistent, "API checker identity must survive cleanup");
+        assert!(!state.has_cleanup_timer, "no idle slot requires a timer");
+    });
+    assert_eq!(pool.checker_ptr(0), Some(diagnostic_ptr));
+    assert_eq!(pool.persistent_ptr(), Some(api_ptr));
+    assert_eq!(
+        pool.region_counts(),
+        (3, 1, 0),
+        "live result lease retains the retired query region"
+    );
+    drop(lease);
+    assert_eq!(pool.region_counts(), (2, 0, 0), "last result lease frees the retired region");
+    pool.discard();
+    drop(diagnostics);
+    pool.free_checkers();
+    assert_eq!(pool.region_counts(), (0, 0, 0), "program disposal frees all remaining regions");
+}
