index 00000000..303c51e4
--- /dev/null
+++ b/crates/tsrs_api/src/checker/rslint.rs
@@ -0,0 +1,271 @@
+//! Additional compiler queries required by rslint. They share the API checker lease and registries.
+
+use rustc_hash::FxHashSet;
+use tsrs_ast::{Node, Symbol, SymbolFlags, SymbolTable};
+use tsrs_checker::{
+    CheckMode, Checker, ContextFlags, IterationTypeKind, IterationUse, TypeFlags, TypeFormatFlags,
+};
+use tsrs_core::{P, collections::OrderedMap, json::Value};
+
+use super::host::{CheckerError, CheckerHost, CheckerResult};
+use super::params::Params;
+use super::setup::Setup;
+
+pub(super) fn handle(host: &dyn CheckerHost, method: &str, params: &Value) -> CheckerResult<Value> {
+    let p = Params::new(params, method)?;
+    if method == "rslint/checkerInfo" {
+        return Ok(object([
+            ("version", Value::Number(1.0)),
+            ("programCreationOptions", Value::Number(2.0)),
+            ("noEmitDiagnostics", Value::Number(1.0)),
+        ]));
+    }
+    let mut s = Setup::new(host, p.u64("snapshot")?, p.project()?)?;
+    match method {
+        "rslint/getErrorType" => {
+            let t = s.c().get_error_type();
+            s.type_response(t)
+        }
+        "rslint/getIndexTypeOfType" => {
+            let t = s.resolve_type(p.u32("type")?)?;
+            let key = s.resolve_type(p.u32("keyType")?)?;
+            let result = s.c().get_index_type_of_type(t, key);
+            result.map_or(Ok(Value::Null), |t| s.type_response(t))
+        }
+        "rslint/getContextualType" => {
+            let node = s.resolve_node(p.string("location")?)?;
+            let flags = ContextFlags::from_bits_retain(p.u32("flags")?);
+            let result = s.c().get_contextual_type(node, flags);
+            result.map_or(Ok(Value::Null), |t| s.type_response(t))
+        }
+        "rslint/typeToString" => {
+            let t = s.resolve_type(p.u32("type")?)?;
+            let node = optional_node(&s, p.string("location")?)?;
+            let flags = TypeFormatFlags::from_bits_retain(p.u32("flags")?);
+            if p.raw("verbosity").is_some() {
+                return Err(CheckerError::unsupported("rslint/typeToString verbosity context"));
+            }
+            Ok(Value::String(s.c().type_to_string_ex_exported(t, node, flags, None)))
+        }
+        "rslint/getPromisedTypeOfPromise" => {
+            let t = s.resolve_type(p.u32("type")?)?;
+            let result = s.c().get_promised_type_of_promise(t);
+            result.map_or(Ok(Value::Null), |t| s.type_response(t))
+        }
+        "rslint/isNonDeferredTypeReference" => {
+            let t = s.resolve_type(p.u32("type")?)?;
+            Ok(Value::Bool(tsrs_checker::is_non_deferred_type_reference(t)))
+        }
+        "rslint/getPropertyNameFromType" => {
+            let t = s.resolve_type(p.u32("type")?)?;
+            Ok(Value::String(tsrs_checker::get_property_name_from_type_exported(t).into_owned()))
+        }
+        "rslint/getSymbolFlags" => {
+            let symbol = s.resolve_symbol(&p.symbol_ref("symbol")?)?;
+            Ok(Value::Number(s.c().get_symbol_flags_exported(symbol).bits() as f64))
+        }
+        "rslint/getResolvedSignature" => {
+            let node = s.resolve_node(p.string("location")?)?;
+            let mode = CheckMode::from_bits_retain(p.u32("checkMode")?);
+            let mut candidates = Vec::new();
+            let out = p.bool("collectCandidates")?.then_some(&mut candidates);
+            let signature = s.c().get_resolved_signature(node, out, mode);
+            let result = s.signature_response(signature)?;
+            let candidates = candidates
+                .into_iter()
+                .map(|signature| s.signature_response(signature))
+                .collect::<CheckerResult<Vec<_>>>()?;
+            Ok(object([("signature", result), ("candidates", Value::Array(candidates))]))
+        }
+        "rslint/getRootSymbols" => {
+            let symbol = s.resolve_symbol(&p.symbol_ref("symbol")?)?;
+            let symbols = s.c().get_root_symbols(symbol);
+            s.symbols_response(&symbols)
+        }
+        "rslint/getTypeOnlyAliasDeclaration" => {
+            let symbol = s.resolve_symbol(&p.symbol_ref("symbol")?)?;
+            let node = s.c().get_type_only_alias_declaration_exported(symbol);
+            node.map_or(Ok(Value::Null), |node| host.node_handle(node).map(Value::String))
+        }
+        "rslint/getSymbolsOfParameterPropertyDeclaration" => {
+            let node = s.resolve_node(p.string("location")?)?;
+            let (parameter, property) =
+                s.c().get_symbols_of_parameter_property_declaration(node, p.string("name")?);
+            Ok(object([
+                ("parameter", s.symbol_response(parameter)?),
+                ("property", s.symbol_response(property)?),
+            ]))
+        }
+        "rslint/isDeprecatedDeclaration" => {
+            let node = s.resolve_node(p.string("location")?)?;
+            Ok(Value::Bool(s.c().is_deprecated_declaration(node)))
+        }
+        "rslint/isUnknownSymbol" => {
+            let symbol = s.resolve_symbol(&p.symbol_ref("symbol")?)?;
+            Ok(Value::Bool(s.c().is_unknown_symbol(symbol)))
+        }
+        "rslint/getSuggestionDiagnostics" => {
+            let file = s.source_file(&p.document("file")?)?;
+            let context = host.context();
+            let diagnostics = s.c().get_suggestion_diagnostics(&context, file);
+            Ok(crate::diagnostics::diagnostic_responses(&diagnostics))
+        }
+        "rslint/getMinArgumentCount" => {
+            let signature = s.resolve_signature(p.u64("signature")?)?;
+            Ok(Value::Number(s.c().rslint_min_argument_count(signature) as f64))
+        }
+        "rslint/getSignatureMinArgumentCount" => {
+            let signature = s.resolve_signature(p.u64("signature")?)?;
+            Ok(Value::Number(signature.min_argument_count() as f64))
+        }
+        "rslint/getMinTypeArgumentCount" => {
+            let types = p
+                .u32_array("types")?
+                .into_iter()
+                .map(|id| s.resolve_type(id))
+                .collect::<CheckerResult<Vec<_>>>()?;
+            Ok(Value::Number(Checker::get_min_type_argument_count(&types) as f64))
+        }
+        "rslint/getConditionalRootNode" => {
+            let t = s.resolve_type(p.u32("type")?)?;
+            if !t.flags().intersects(TypeFlags::Conditional) {
+                return Err(CheckerError::client("expected conditional type"));
+            }
+            let node = t.as_conditional_type().root.get().and_then(|root| root.node.get());
+            node.map_or(Ok(Value::Null), |node| host.node_handle(node).map(Value::String))
+        }
+        "rslint/getIterationTypeOfIterable" => {
+            let t = s.resolve_type(p.u32("type")?)?;
+            let use_ = IterationUse::from_bits_retain(p.u32("use")?);
+            let kind = match p.u32("typeKind")? {
+                0 => IterationTypeKind::Yield,
+                1 => IterationTypeKind::Return,
+                2 => IterationTypeKind::Next,
+                _ => return Err(CheckerError::invalid("invalid iteration type kind")),
+            };
+            let error_node = optional_node(&s, p.string("errorNode")?)?;
+            let result = s.c().rslint_iteration_type(use_, kind, t, error_node);
+            result.map_or(Ok(Value::Null), |t| s.type_response(t))
+        }
+        "rslint/isTypeStrictSubtypeOf" => {
+            let source = s.resolve_type(p.u32("source")?)?;
+            let target = s.resolve_type(p.u32("target")?)?;
+            Ok(Value::Bool(s.c().rslint_strict_subtype(source, target)))
+        }
+        "rslint/getGlobalSymbol" => {
+            if p.raw("diagnostic").is_some() {
+                return Err(CheckerError::unsupported(
+                    "rslint/getGlobalSymbol diagnostic argument",
+                ));
+            }
+            let symbol = s.c().get_global_symbol_exported(
+                p.string("name")?,
+                SymbolFlags::from_bits_retain(p.u32("meaning")?),
+                None,
+            );
+            s.opt_symbol_response(symbol)
+        }
+        "rslint/getMergedSymbol" | "rslint/skipAlias" | "rslint/resolveAlias" => {
+            let symbol = if p.raw("symbol").is_some() {
+                Some(s.resolve_symbol(&p.symbol_ref("symbol")?)?)
+            } else {
+                None
+            };
+            if method == "rslint/resolveAlias" {
+                let (resolved, ok) = s.c().resolve_alias_exported(symbol);
+                return Ok(object([
+                    ("symbol", s.opt_symbol_response(resolved)?),
+                    ("ok", Value::Bool(ok)),
+                ]));
+            }
+            let symbol = symbol.ok_or_else(|| CheckerError::client("symbol is required"))?;
+            let result = if method == "rslint/skipAlias" {
+                s.c().skip_alias(symbol)
+            } else {
+                s.c().get_merged_symbol_exported(symbol)
+            };
+            s.symbol_response(result)
+        }
+        "rslint/getAccessedPropertyName" => {
+            let node = s.resolve_node(p.string("location")?)?;
+            let (name, ok) = s.c().get_accessed_property_name(node);
+            Ok(object([("name", Value::String(name.into_owned())), ("ok", Value::Bool(ok))]))
+        }
+        "rslint/getPropertyNameForKnownSymbolName" => {
+            Ok(Value::String(s.c().get_property_name_for_known_symbol_name(p.string("name")?)))
+        }
+        "rslint/symbolGraph" => {
+            let root = s.resolve_symbol(&p.symbol_ref("symbol")?)?;
+            symbol_graph(&s, root)
+        }
+        _ => Err(CheckerError::unsupported(format!("unknown rslint checker method {method}"))),
+    }
+}
+
+fn optional_node(s: &Setup<'_>, handle: &str) -> CheckerResult<Option<P<Node>>> {
+    if handle.is_empty() { Ok(None) } else { s.resolve_node(handle).map(Some) }
+}
+
+fn object<const N: usize>(entries: [(&str, Value); N]) -> Value {
+    Value::Object(entries.into_iter().map(|(key, value)| (key.to_string(), value)).collect())
+}
+
+fn symbol_id(symbol: P<Symbol>, queue: &mut Vec<P<Symbol>>, seen: &mut FxHashSet<u64>) -> Value {
+    let id = tsrs_ast::get_symbol_id(symbol).0;
+    if seen.insert(id) {
+        queue.push(symbol);
+    }
+    Value::String(id.to_string())
+}
+
+fn symbol_table(
+    table: P<SymbolTable>,
+    queue: &mut Vec<P<Symbol>>,
+    seen: &mut FxHashSet<u64>,
+) -> Value {
+    Value::Object(
+        table
+            .entries()
+            .into_iter()
+            .map(|(name, symbol)| (name.to_string(), symbol_id(symbol, queue, seen)))
+            .collect(),
+    )
+}
+
+fn symbol_graph(s: &Setup<'_>, root: P<Symbol>) -> CheckerResult<Value> {
+    let mut queue = Vec::new();
+    let mut seen = FxHashSet::default();
+    let root_id = symbol_id(root, &mut queue, &mut seen);
+    let mut symbols = OrderedMap::default();
+    let mut index = 0;
+    while index < queue.len() {
+        let symbol = queue[index];
+        let Value::Object(mut row) = s.symbol_response(symbol)? else { unreachable!() };
+        let id = tsrs_ast::get_symbol_id(symbol).0.to_string();
+        row.insert("id".into(), Value::String(id.clone()));
+        row.insert("name".into(), Value::String(symbol.name().to_string()));
+        row.insert("apiName".into(), Value::String(tsrs_ast::escape_symbol_name(symbol.name())));
+        // Keep the binder schema's required empty declarations array as well as exact table presence.
+        row.entry("declarations".into()).or_insert_with(|| Value::Array(Vec::new()));
+        if let Some(parent) = symbol.parent() {
+            row.insert("parent".into(), symbol_id(parent, &mut queue, &mut seen));
+        }
+        if let Some(export) = symbol.export_symbol() {
+            row.insert("exportSymbol".into(), symbol_id(export, &mut queue, &mut seen));
+        }
+        if let Some(members) = symbol.members() {
+            row.insert("members".into(), symbol_table(members, &mut queue, &mut seen));
+        }
+        if let Some(exports) = symbol.exports() {
+            row.insert("exports".into(), symbol_table(exports, &mut queue, &mut seen));
+        }
+        symbols.insert(id, Value::Object(row));
+        index += 1;
+    }
+    Ok(object([
+        ("snapshot", Value::Number(s.sd.scope.handle as f64)),
+        ("project", Value::String(s.sd.project.clone())),
+        ("root", root_id),
+        ("symbols", Value::Object(symbols)),
+    ]))
+}
