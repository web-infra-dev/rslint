{
  "name": "rslint-monorepo",
  "version": "0.9.5",
  "private": true,
  "description": "Rslint Monorepo",
  "homepage": "https://github.com/web-infra-dev/rslint#readme",
  "bugs": {
    "url": "https://github.com/web-infra-dev/rslint/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/web-infra-dev/rslint.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "pnpm --filter @rslint/api build && pnpm --filter @rslint/core build",
    "build:npm": "node scripts/build-npm.mjs rslint",
    "build:website": "node scripts/tsrs/unsupported-entrypoint.mjs website",
    "bench:cli": "pnpm --filter rslint-bench-cli run bench",
    "check-spell": "pnpx cspell lint --no-progress --show-context",
    "version": "zx scripts/version.mjs",
    "release": "pnpm --filter='@rslint/core' --filter='@rslint/native-*' -r publish --no-git-checks",
    "sync:version-info": "node scripts/tsrs/unsupported-entrypoint.mjs release-version-metadata",
    "publish:vsce": "node scripts/tsrs/unsupported-entrypoint.mjs vscode-publication",
    "publish:ovsx": "node scripts/tsrs/unsupported-entrypoint.mjs vscode-publication",
    "format": "rs fmt",
    "format:check": "rs fmt --check",
    "test": "pnpm run test:rust",
    "typecheck": "pnpm tsc -b tsconfig.json --noEmit",
    "lint": "rslint --config rslint.config.ts",
    "prepare": "rs hooks",
    "migrate:tests": "sg scan -r ast-grep-rule.yml ./packages/rslint-test-tools/tests/typescript-eslint/rules/**/*.test.ts --update-all",
    "test:rust": "node --test scripts/tsrs/build-rust.test.mjs && node scripts/tsrs/build-rust.mjs --test && pnpm --filter @rslint/core test:rust"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@rslint/core": "workspace:*",
    "@rspress/core": "catalog:",
    "@types/react": "catalog:",
    "ajv": "catalog:",
    "rstack": "catalog:",
    "typescript": "catalog:",
    "zx": "catalog:"
  },
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "pnpm": ">=10.34.4"
  },
  "files": []
}
