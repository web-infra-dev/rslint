{
  "extends": ["../../tsconfig.build.json"],
  "compilerOptions": {
    "customConditions": ["@typescript/source"],
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["esnext", "dom"],
    "noImplicitReturns": false,
    "noImplicitOverride": false,
    "rootDir": "./src",
    // The declaration bundler resolves the compatibility layer's enum types
    // through this mapping; runtime bundling uses its local package imports.
    "paths": {
      "#enums/*": ["./src/ast-compat/enums/*.enum.ts"]
    }
  },

  "include": ["src/**/*.ts"],
  "references": []
}
