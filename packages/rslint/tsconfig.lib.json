{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    "types": ["node"],
    "tsBuildInfoFile": "${configDir}/node_modules/.cache/rslint-core-dts.tsbuildinfo"
  },
  "exclude": [
    "${configDir}/src/**/*.spec.ts",
    "${configDir}/src/**/*.test.ts",
    "${configDir}/**/fixtures/**",
    "${configDir}/src/eslint-plugin/**",
    "${configDir}/src/languages/**"
  ]
}
