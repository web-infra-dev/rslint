{
  "name": "@rslint/core",
  "version": "0.9.5",
  "exports": {
    ".": {
      "@typescript/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./service": {
      "types": "./unsupported.d.ts",
      "default": "./unsupported.mjs"
    },
    "./internal": {
      "types": "./unsupported.d.ts",
      "default": "./unsupported.mjs"
    },
    "./config-loader": {
      "@typescript/source": "./src/config/config-loader.ts",
      "default": "./dist/config-loader.js"
    },
    "./eslint-plugin": {
      "types": "./unsupported.d.ts",
      "default": "./unsupported.mjs"
    },
    "./bin": "./bin/rslint.js",
    "./package.json": "./package.json"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-infra-dev/rslint"
  },
  "scripts": {
    "build:bin": "node ../../scripts/tsrs/build-rust.mjs",
    "build:debug": "node ../../scripts/tsrs/build-rust.mjs --debug",
    "build:js": "rs lib",
    "dev": "rs lib --watch",
    "build": "pnpm build:bin && pnpm build:js",
    "test": "pnpm run test:rust",
    "test:update": "pnpm run test:rust --update",
    "test:rust": "rs test run tests/rust-admission.test.ts tests/rust-config.test.ts tests/rust-projects.test.ts tests/rust-engine.test.ts tests/rust-cli.test.ts tests/rust-public-api.test.ts"
  },
  "files": [
    "bin/rslint.js",
    "dist/",
    "THIRD-PARTY-NOTICES.md",
    "unsupported.mjs",
    "unsupported.d.ts"
  ],
  "bin": {
    "rslint": "./bin/rslint.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "description": "rslint core library",
  "publisher": "rslint",
  "keywords": [
    "rslint",
    "linter",
    "typescript",
    "rust"
  ],
  "devDependencies": {
    "@eslint/plugin-kit": "catalog:",
    "@rslint/api": "workspace:*",
    "@types/node": "catalog:",
    "@types/picomatch": "catalog:",
    "@typescript-eslint/scope-manager": "catalog:",
    "@typescript-eslint/visitor-keys": "catalog:",
    "eslint-scope": "catalog:",
    "eslint-visitor-keys": "catalog:",
    "espree": "catalog:",
    "esquery": "catalog:",
    "globals": "catalog:",
    "json-schema-to-typescript": "catalog:",
    "tinyglobby": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "jiti": "catalog:"
  },
  "peerDependenciesMeta": {
    "jiti": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@rslint/native-darwin-arm64": "workspace:*",
    "@rslint/native-darwin-x64": "workspace:*",
    "@rslint/native-linux-arm64-gnu": "workspace:*",
    "@rslint/native-linux-arm64-musl": "workspace:*",
    "@rslint/native-linux-x64-gnu": "workspace:*",
    "@rslint/native-linux-x64-musl": "workspace:*",
    "@rslint/native-win32-arm64-msvc": "workspace:*",
    "@rslint/native-win32-x64-msvc": "workspace:*"
  },
  "dependencies": {
    "picomatch": "catalog:"
  }
}
