{
  "name": "rslint",
  "displayName": "Rslint",
  "description": "Language support for Rslint",
  "version": "0.7.3",
  "icon": "images/icon.png",
  "private": true,
  "publisher": "rstack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-infra-dev/rslint"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "rslint",
    "linter",
    "typescript",
    "go"
  ],
  "engines": {
    "vscode": "^1.131.0"
  },
  "main": "./dist/main.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact"
  ],
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Rslint",
      "properties": {
        "rslint.enable": {
          "order": 0,
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Enable/disable rslint"
        },
        "rslint.runtime.path": {
          "order": 1,
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Optional path to a complete `@rslint/core` package directory. Relative paths are resolved from the VS Code workspace folder. When empty, Rslint resolves the nearest local `@rslint/core` separately for each document."
        },
        "rslint.trace.server": {
          "order": 2,
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "package": "vsce package",
    "test": "rimraf .vscode-test-out && tsgo -p tsconfig.spec.emit.json && node .vscode-test-out/__tests__/runTest.js"
  },
  "devDependencies": {
    "@rslint/core": "workspace:*",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "catalog:",
    "@vscode/test-electron": "catalog:",
    "@vscode/vsce": "catalog:",
    "esbuild": "catalog:",
    "fast-glob": "catalog:",
    "mocha": "catalog:",
    "ovsx": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "@typescript/native-preview": "catalog:",
    "vscode-languageclient": "catalog:",
    "vscode-languageserver": "catalog:",
    "vscode-languageserver-textdocument": "catalog:"
  },
  "files": []
}
