{
  "extends": ["../../tsconfig.spec.json"],
  "include": [
    "tests/**/*.ts",
    "../rslint/src/**/*.ts",
    "../rslint-rule-tester/src/**/*.ts",
    "../rslint-rule-tester/tests/**/*.ts",
    "../../internal/plugins/unicorn/rules/name_replacements/testdata/name_replacements_v77.json"
  ],
  "compilerOptions": {
    "rootDir": "../..",
    "paths": {
      "#enums/*": [
        "../../typescript-go/packages/typescript/src/enums/*.enum.ts"
      ]
    },
    "moduleResolution": "bundler",
    "module": "preserve"
  },
  "exclude": ["./tests/**/fixtures/**"],
  "references": [{ "path": "../rslint/compiler-syntax" }]
}
