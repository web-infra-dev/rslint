Additional package publishing scenarios.

# cspell:ignore npmignore

-- git/package.json --
{}
-- git/.gitignore --
secret.js
-- npm/package.json --
{}
-- npm/.gitignore --
secret.js
-- npm/.npmignore --
private.js
-- files/package.json --
{"files":["lib"],"main":"src/cli.js"}
-- files/.gitignore --
lib/keep.js
-- files/.npmignore --
lib/drop.js
-- extended/package.json --
{"files":["lib/@(a|b).js","bin/cli{1..3}.js","!lib/private/**"]}
-- empty/package.json --
{}

-- unicode/package.json --
{"files":["lib/@(??).js"]}

-- zero-step/package.json --
{"files":["lib/cli{1..3..0}.js"]}

-- rooted-exclusion/package.json --
{"bin":"lib/foo.js","files":["lib","!/foo.js"]}
-- unrooted-exclusion/package.json --
{"bin":"lib/foo.js","files":["lib","!foo.js"]}
-- rooted-extended-exclusion/package.json --
{"bin":"lib/foo.js","files":["lib","!/@(foo).js"]}
-- unrooted-extended-exclusion/package.json --
{"bin":"lib/foo.js","files":["lib","!@(foo).js"]}

-- class-exclusion/package.json --
{"bin":"lib/foo.js","files":["lib/[!b]oo.js","lib/[^b]oo.js"]}
-- newline-files/package.json --
{"bin":"lib/foo.js","files":["lib/foo.js\nbar.js"]}
