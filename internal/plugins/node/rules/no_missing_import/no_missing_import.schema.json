{
  "type": "array",
  "items": [
    {
      "type": "object",
      "properties": {
        "allowModules": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:virtual:)?(?:@[a-zA-Z0-9_\\-.]+/)?[a-zA-Z0-9_\\-.]+$"
          },
          "uniqueItems": true
        },
        "resolvePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "resolverConfig": {
          "type": "object",
          "properties": {},
          "additionalProperties": true
        },
        "tryExtensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\."
          },
          "uniqueItems": true
        },
        "tsconfigPath": {
          "type": "string"
        },
        "typescriptExtensionMap": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "pattern": "^(?:|\\.\\w+)$"
                  },
                  {
                    "type": "string",
                    "pattern": "^\\.\\w+$"
                  }
                ],
                "additionalItems": false
              },
              "uniqueItems": true
            },
            {
              "type": "string",
              "enum": [
                "react",
                "react-jsx",
                "react-jsxdev",
                "react-native",
                "preserve"
              ]
            }
          ]
        },
        "ignoreTypeImport": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    }
  ],
  "minItems": 0,
  "maxItems": 1
}
